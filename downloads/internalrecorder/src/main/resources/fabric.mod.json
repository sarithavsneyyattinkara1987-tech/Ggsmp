{
  "schemaVersion": 1,
  "id": "internalrecorder",
  "version": "${version}",
  "name": "InternalRecorder",
  "description": "In-process Minecraft video recording with asynchronous framebuffer capture.",
  "authors": ["InternalRecorder contributors"],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.internalrecorder.InternalRecorderClient"
    ]
  },
  "mixins": [
    {
      "config": "internalrecorder.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}